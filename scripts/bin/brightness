#!/bin/sh

usage() {
    echo "Usage:
brightness [-h|--help] [-s|--software] [<percent>|+[<percent>]|-[<percent>]]

This script uses backlight_control for the internal display and xrandr for
external displays.

Examples:
brightness              Show current brightness.
brightness <percent>    Set brightness to <percent>%.
brightness +<percent>   Increase brightness by <percent>%.
brightness +            Increase brightness by 10%.
brightness -<percent>   Decrease brightness by <percent>%.
brightness -            Decrease brightness by 10%.
"
}

exists() { command -v "$1" > /dev/null 2>&1 ; }

is_single_line() {
    test -n "$1" && [ $(echo "$1" | wc -l) = 1 ]
}

get_active_monitor() {
    enabled_devices=$(rg -l ^enabled /sys/class/drm/*/enabled | sed -E 's#.*/card[0-9]+-##; s/-A-/-/; s#/enabled##')
    if is_single_line "$enabled_devices"; then
        echo "$enabled_devices"
        return
    fi

    monitor_xpos=$(xdotool getactivewindow getwindowgeometry | grep Position | grep -o '[0-9]*,' | tr -d ,)
    active_mon=$(xrandr | grep -w connected | grep "+$monitor_xpos+" | head -n 1 | cut -d " " -f1)
    if [ $active_mon ]; then
        echo "$active_mon"
    else
        # use primary monitor as fallback
        xrandr | grep -w 'connected primary' | head -n 1 | cut -d " " -f1
    fi
}

print_hardware_brightness() {
    # https://github.com/MaxGyver83/backlight_control/tree/print_brightness
    backlight_control
}

get_software_brightness() {
    cached_brightness="/tmp/brightness-$active_monitor"
    if [ -e "$cached_brightness" ]; then
        cat "$cached_brightness"
    else
        stdbuf -o0 xrandr --verbose | grep "^$active_monitor" -A 5 | awk '/Brightness/ { print $2; exit }'
    fi
}

set_hardware_brightness() {
    case "$1" in
    "")   print_hardware_brightness; exit 0 ;;
    *)    backlight_control "$1" ;;
    esac

    notify-send -t 500 $(print_hardware_brightness | sed -E 's/\.0+$//')"% (hardware)"
}

set_xrandr_brightness() {
    BRIGHT=$(get_software_brightness)
    STEP=0.1

    case "$1" in
    +[1-9]|+[1-9][0-9])
        NEWBRIGHT=$(echo "scale=2; $BRIGHT $1/100" | bc)
        if [ "$(echo "$NEWBRIGHT > 1.0" | bc)" -eq 1 ]; then
            NEWBRIGHT='1.0'
        fi
        ;;
    -[1-9]|-[1-9][0-9])
        NEWBRIGHT=$(echo "scale=2; $BRIGHT $1/100" | bc)
        if [ "$(echo "$NEWBRIGHT < 0.1" | bc)" -eq 1 ]; then
            NEWBRIGHT='0.1'
        fi
        ;;
    100)
        NEWBRIGHT='1.0'
        ;;
    [1-9][0-9])
        NEWBRIGHT="0.$1"
        ;;
    [1-9])
        NEWBRIGHT="0.$1"
        ;;
    *)
        echo $BRIGHT
        exit 0
        ;;
    esac

    # first_monitor=$(xrandr | grep -w connected | head -n 1 | cut -d " " -f1)
    # xrandr --output "$first_monitor" --brightness "$NEWBRIGHT"

    xrandr --output "$active_monitor" --brightness "$NEWBRIGHT"
    echo "$NEWBRIGHT" > /tmp/brightness-"$active_monitor"
    notify-send -t 500 $(echo "$NEWBRIGHT * 100" | bc | sed -E 's/\.0+$//')"% (xrandr)"
}

case "$1" in
-h|--help) usage; exit ;;
-s|--software) SOFTWARE=1; shift ;;
esac

case "$1" in
+)            PARAM=+10 ;;
-)            PARAM=-10 ;;
[+-][1-9]|[+-][1-9][0-9])
              PARAM="$1" ;;
max|full|100) PARAM=100 ;;
[1-9][0-9])   PARAM="$1" ;;
[1-9])        PARAM="$1" ;;
'')           ;; #print_hardware_brightness; exit 0 ;;
*)            printf "Unknown argument: $1\n\n"; usage; exit 1 ;;
esac

active_monitor=$(get_active_monitor)

if [ "$(hostname)" = 'max-laptop' ] && [ "$active_monitor" = 'eDP-1' ] && exists backlight_control && ! [ $SOFTWARE ]; then
    [ "$1" ] && printf "Set " || printf "Current "
    echo "hardware brightness"
    set_hardware_brightness "$PARAM"
else
    [ "$1" ] && printf "Set " || printf "Current "
    echo "xrandr brightness"
    set_xrandr_brightness "$PARAM"
fi

exec ~/.config/dwm/update-status.bash
