#!/bin/sh

usage() {
    echo "Usage: $0 [-h|--help] [-s|--stable] [-b|--background] [-d|--debug] [-l|--log] [-k|--keychron-only] [--dev] [-- args...]"
}

while [ "$#" -gt 0 ]; do case $1 in
    -h|--help) usage; exit;;
    -s|--stable) STABLE=1; shift;;
    -b|--background) BACKGROUND=1; shift;;
    -l|--log) LOG=1; shift;;
    -d|--debug) DEBUG=1; shift;;
    -p|--parse-only) PARSE=1; shift;;
    -k|--keychron-only) KEYCHRON=1; shift;;
    --dev) DEV=1; shift;;
    --) shift; break;;
    *) echo "Unknown parameter passed: $1"; shift; shift;;
esac; done

echo BACKGROUND=$BACKGROUND
echo STABLE=$STABLE
echo DEBUG=$DEBUG

if [ $STABLE ]; then
    BINARY=~/repos/keyboard-layouts/keyboard-layouts-stable
    CONFIG=config/vou-stable.toml
elif [ $DEV ]; then
    BINARY=~/repos/keyboard-layouts/keyboard-layouts-dev
    CONFIG=config/vou.toml
else
    BINARY=~/repos/keyboard-layouts/keyboard-layouts
    CONFIG=config/vou.toml
fi

[ -x "$BINARY" ] || exit 1
[ -e ~/repos/keyboard-layouts/config/vou.toml ] || exit 1

[ -e /dev/input/by-id/usb-Keychron_Keychron_K6-event-kbd ] && K6_CONNECTED=1
echo K6_CONNECTED=$K6_CONNECTED

k6_bluetooth_device="/dev/input/$(grep -B 8 -A 4 12001 /proc/bus/input/devices | grep Keychron -A 4 | grep -oE 'event[0-9]+')"
[ -e $k6_bluetooth_device ] && K6_BLUETOOTH_CONNECTED=1
echo K6_BLUETOOTH_CONNECTED=$K6_BLUETOOTH_CONNECTED

if [ $PARSE ]; then
    set -- "$@" -p
else
    pkill -f 'kmonad'
    if [ $KEYCHRON ]; then
        pkill -f 'keyboard-layouts.*usb-Keychron_Keychron_K6-event-kbd'
    else
        pkill -f 'keyboard-layouts/keyboard-layouts'
    fi
fi

[ $DEBUG ] && BINARY="$BINARY --debug -vvvv"

# sleep to not miss the return key release event
sleep 0.2

if [ ! $KEYCHRON ] && [ "$HOSTNAME" != max-kron ] ; then
    echo "Start keyboard-layouts for built-in keyboard"
    LOGFILE=$HOME/log/"$(date '+%Y-%m-%d_%H.%M.%S')_key.log"
    COMMAND="$BINARY --config-file $CONFIG ${LOG:+--key-log-file "$LOGFILE"} $@"
    if [ $BACKGROUND ] || [ $K6_CONNECTED ]; then
        $COMMAND > /dev/null &
    else
        exec $COMMAND
    fi
fi

if [ $K6_CONNECTED ]; then
    # pkill -f 'keyboard-layouts.*usb-Keychron_Keychron_K6-event-kbd'
    echo "Start keyboard-layouts for Keychron K6 (via USB)"
    LOGFILE=$HOME/log/"$(date '+%Y-%m-%d_%H.%M.%S')_key_K6.log"
    COMMAND="$BINARY \
          --config-file $CONFIG \
          --device /dev/input/by-id/usb-Keychron_Keychron_K6-event-kbd \
          ${LOG:+--key-log-file "$LOGFILE"} $@"
    if [ $BACKGROUND ]; then
        $COMMAND > /dev/null &
    else
        exec $COMMAND
    fi
fi

if [ $K6_BLUETOOTH_CONNECTED ]; then
    # pkill -f 'keyboard-layouts.*usb-Keychron_Keychron_K6-event-kbd'
    echo "Start keyboard-layouts for Keychron K6 (via Bluetooth)"
    LOGFILE=$HOME/log/"$(date '+%Y-%m-%d_%H.%M.%S')_key_K6_bt.log"
    COMMAND="$BINARY \
          --config-file $CONFIG \
          --device "$k6_bluetooth_device" \
          ${LOG:+--key-log-file "$LOGFILE"} $@"
    if [ $BACKGROUND ]; then
        $COMMAND > /dev/null &
    else
        exec $COMMAND
    fi
fi
