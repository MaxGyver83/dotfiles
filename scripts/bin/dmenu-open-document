#!/bin/bash

uri_to_path() {
    local uri=$1
    local path

    # strip file://
    path=${uri#file://}

    # replace % with \x for printf
    path=${path//%/\\x}

    # decode percent-encoding (printf -v writes back, no subshell needed)
    printf -v path '%b' "$path"

    # replace $HOME with ~
    case $path in
        "$HOME"/*) path="~${path#$HOME}" ;;
        /media/ubuntu/home/max/*) path="~${path#/media/ubuntu/home/max}" ;;
        /media/home/max/*) path="~${path#/media/home/max}" ;;
    esac

    printf '%s\n' "$path"
}

recently-opened-documents --frecency \
  | while read -r uri; do uri_to_path "$uri"; done \
  | uniq \
  | dmenu -i -c -l 20 -fn 'monospace:size=16' \
  | sed "s:^~:$HOME:" \
  | xargs -d '\n' open
